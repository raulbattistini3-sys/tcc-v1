# Copy to .env (never commit it). The server exits with a [config] message when something is missing.

# The logs database. Supabase: Project → Connect → "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# For `pnpm db:migrate` only: the "Session pooler" (port 5432) URL. Unset: DATABASE_URL is used.
DATABASE_MIGRATION_URL=
# Supabase's CA certificate (Dashboard → Database → SSL Configuration → Download certificate).
# Required for a remote database: TLS is always verified.
DATABASE_CA_CERT=./prod-ca-2021.crt
# off for a local Postgres (the default for localhost); verify otherwise
DATABASE_SSL=

HOST=0.0.0.0
PORT=8787
# Bearer token for every route but /health. Empty: a random one is printed at start.
TCC_TOKEN=
# The dashboard's origin(s), comma-separated
WEB_ORIGINS=http://localhost:5175
# 1: GET routes without a token (a trusted machine only)
PUBLIC_READS=0
LOG_LEVEL=info
# Uploads (sweeps, scrapes) are written here before the database; `pnpm spool:replay` retries what the
# database refused. Relative to apps/server.
SPOOL_DIR=spool
# The extension's uploads as readable JSON, one log<Date.now()>.json per second that had uploads.
# Relative to apps/server; empty turns it off.
TELEMETRY_LOG_DIR=logs
