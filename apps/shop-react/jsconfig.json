{
  // JSX + JSDoc, type-checked like the core: `npm run check`.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@core/*": ["../../src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "../shared/**/*.js"]
}
