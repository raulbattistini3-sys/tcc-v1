{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "shop-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "shop",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "outputPath": "dist",
            "baseHref": "/angular/",
            "polyfills": [],
            "inlineStyleLanguage": "scss",
            "styles": ["src/styles.scss"],
            "stylePreprocessorOptions": { "includePaths": ["../shared/styles"] },
            "assets": []
          },
          "configurations": {
            "production": {
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
              "outputHashing": "all",
              "sourceMap": true,
              "budgets": [{ "type": "initial", "maximumWarning": "1mb", "maximumError": "2mb" }]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "zone": {
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false },
              "outputHashing": "all",
              "sourceMap": true,
              "outputPath": "dist-zone",
              "baseHref": "/angular-zone/",
              "polyfills": ["zone.js"],
              "fileReplacements": [{ "replace": "src/app/change-detection.ts", "with": "src/app/change-detection.zone.ts" }]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "port": 5175, "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "production": { "buildTarget": "shop-angular:build:production" },
            "development": { "buildTarget": "shop-angular:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
