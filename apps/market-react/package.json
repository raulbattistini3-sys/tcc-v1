{
  "name": "tcc-market-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketplace-style shop (home, category listing, product page, cart) over the scheduler core: React 19 + MUI 9 with Pigment CSS (no runtime CSS-in-JS) + Zustand + React Router + TanStack Virtual + Sass modules.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-pigment-css": "^7.3.11",
    "@pigment-css/react": "^0.0.31",
    "@tanstack/react-virtual": "^3.14.26",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@pigment-css/vite-plugin": "^0.0.31",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "sass": "^1.108.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
